# TANIA environment contract (TANIA_PRD_v2.0.md §73).
# Copy to .env.local and fill in. Never commit real values.
#
# Only NEXT_PUBLIC_* variables may reach browser code. Everything else is
# server-only and is enforced by eslint.config.mjs.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never import into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# --- Microsoft Entra ID (enterprise SSO) ------------------------------------
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=

# --- AI Gateway -------------------------------------------------------------
AI_GATEWAY_URL=
AI_GATEWAY_KEY=
EMBEDDING_MODEL=
LLM_MODEL=

# --- JARVIS -----------------------------------------------------------------
JARVIS_API_URL=
JARVIS_API_KEY=
