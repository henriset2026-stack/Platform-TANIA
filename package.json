{
  "name": "tania",
  "version": "0.1.0",
  "private": true,
  "description": "TANIA — Talent Intelligence, Analytics, Insight & Action. Chapter DPS, Telkom Indonesia.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:ai": "vitest run tests/ai",
    "test:rls": "vitest run --config vitest.rls.config.mts",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "db:seed": "node scripts/db.mjs seed",
    "db:reset": "node scripts/db.mjs reset"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
