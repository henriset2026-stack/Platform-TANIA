# TANIA environment contract (TANIA_PRD_v2.0.md §73, plus deployment additions).
# Copy to .env.local for local work; set the same names in Vercel → Settings →
# Environment Variables for deployments. NEVER put real values in this file —
# tests/unit/env-contract.test.ts fails if any value is non-empty.
#
# Only NEXT_PUBLIC_* variables may reach browser code. Everything else is
# server-only, enforced by `server-only` imports and eslint.config.mjs.
# docs/DEPLOYMENT.md says which Vercel environment needs each one.

# --- Supabase (REQUIRED) ----------------------------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…) or legacy anon JWT. Browser-safe: RLS
# applies to every request made with it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_…) or legacy service_role JWT. BYPASSES RLS.
# NOT needed by the deployed app — do not set it in Vercel. Used only by
# tests/rls fixtures and maintenance scripts, from a trusted machine.
SUPABASE_SERVICE_ROLE_KEY=

# --- Deployment (REQUIRED in Vercel Production) ------------------------------
# Canonical origin for OAuth redirects, e.g. https://tania.example.com
# Previews fall back to Vercel's automatic VERCEL_URL; local dev falls back to
# the request host. Must match an entry in Supabase Auth → URL Configuration.
SITE_URL=
# debug | info | warn | error. Defaults to info in production, debug elsewhere.
LOG_LEVEL=

# --- Microsoft Entra ID (configured in SUPABASE, not in Vercel) --------------
# The app does not read these. Enter them in Supabase → Authentication →
# Providers → Azure. Listed here so the contract stays complete.
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=

# --- AI Gateway (OPTIONAL — the assistant reports "not configured" without) --
# All three of URL, key and model are required together.
# LLM_PROVIDER selects the adapter: gemini, or openai-compatible (a router
# such as NARA; AI_GATEWAY_URL is its /v1 base; evaluation only until a
# data-governance decision covers it). For Gemini, set
# AI_GATEWAY_URL=https://generativelanguage.googleapis.com and put the
# Google AI Studio key in AI_GATEWAY_KEY (server-only; never NEXT_PUBLIC_).
LLM_PROVIDER=
AI_GATEWAY_URL=
AI_GATEWAY_KEY=
EMBEDDING_MODEL=
LLM_MODEL=

# --- AI kill switches (OPTIONAL; server-side, read per request) --------------
# Empty = default. "true"/"1"/"on"/"yes" = on; ANY other value = off (fail
# closed, so a typo in an incident still switches the capability off).
# Defaults: assistant, tools and RAG on; JARVIS handoff OFF (no transport).
AI_ASSISTANT_ENABLED=
TOOL_EXECUTION_ENABLED=
RAG_ENABLED=
JARVIS_HANDOFF_ENABLED=

# --- JARVIS (OPTIONAL — not read by any code yet) ----------------------------
JARVIS_API_URL=
JARVIS_API_KEY=
